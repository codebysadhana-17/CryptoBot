# Trading symbol
TRADING_SYMBOL=ETH/USDT

# LIVE trading only. Keep AUTO OFF while validating exchange connections.
AUTO_TRADE_ENABLED=false
LIVE_TRADING_ARMED=false
EMERGENCY_STOP=true

# Risk controls
DEFAULT_TRADE_AMOUNT=5
MAX_TRADE_AMOUNT_USDT=5
MIN_TRADE_USDT=5
MIN_PROFIT=0.01
MIN_PROFIT_PERCENT=0.20
PROFIT_SAFETY_BUFFER_PERCENT=0.05
PROFIT_SAFETY_BUFFER_USDT=0.01
MAX_DAILY_LOSS_USDT=0.50
AUTO_TRADE_COOLDOWN=30
REFRESH_INTERVAL=1

# Production
DEBUG=false
PORT=5000

# Prefer environment variables for exchange credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Low-latency market-data stream
WEBSOCKET_ENABLED=true

# Optional inventory rebalancing - keep false until addresses/networks are verified
AUTO_REBALANCE_ENABLED=false
REBALANCE_ARMED=false
REBALANCE_MIN_USDT=25
REBALANCE_MAX_USDT=25
REBALANCE_ASSET=ETH
REBALANCE_NETWORK=
REBALANCE_DESTINATION_EXCHANGE=
REBALANCE_DESTINATION_ADDRESS=
REBALANCE_DESTINATION_TAG=


# Advanced execution (all OFF by default)
ASYNC_EXECUTION_ENABLED=false
DEX_FLASHLOAN_ENABLED=false
DEX_FLASHLOAN_CHAIN=ethereum
DEX_FLASHLOAN_PROVIDER=aave_v3
DEX_FLASHLOAN_RECEIVER=

# Guarded asset transfer
REBALANCE_MAX_ASSET_AMOUNT=0.02
REBALANCE_REQUIRE_WHITELIST=true
REBALANCE_ALLOWED_ADDRESSES=
